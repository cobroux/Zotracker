# Modèle de /opt/zotracker/.env sur la VM Oracle (chmod 600). Ne jamais commiter de valeurs réelles.
ADMIN_PASSWORD=
TRACK_RETENTION_DAYS=90
VAPID_SUBJECT=mailto:moi@exemple.fr
NTFY_SERVER=https://ntfy.sh
# Topic ntfy privé et difficile à deviner (alertes de sauvegarde et de déploiement)
NTFY_TOPIC=
BACKUP_DIR=/opt/zotracker/backups
BACKUP_KEEP_DAYS=14
# Clé PUBLIQUE age (age1...) ; la clé privée ne va jamais sur la VM
BACKUP_AGE_RECIPIENT=
BACKUP_RCLONE_REMOTE=oracle:zotracker-backups
