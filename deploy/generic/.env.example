# Chemin générique (ghcr + Caddy propre), NON utilisé sur Oracle : voir deploy/oracle/
# Copie ce fichier en .env sur le serveur :  cp .env.example .env && chmod 600 .env
# Ne commite JAMAIS le fichier .env.

# ---- Domaine (doit pointer vers l'IP du serveur : enregistrement DNS A/AAAA)
DOMAIN=suivi.mondomaine.fr
# e-mail pour Let's Encrypt (avertissements d'expiration)
ACME_EMAIL=moi@mondomaine.fr

# ---- Image à déployer (mise à jour automatiquement par la CI via deploy.sh)
ZOTRACKER_IMAGE=ghcr.io/cobroux/zotracker
ZOTRACKER_TAG=latest

# ---- Application
# Mot de passe admin : laisse vide pour en générer un (affiché une seule fois dans
# `docker compose logs app`), puis change-le depuis l'admin. Sinon 16+ caractères.
ADMIN_PASSWORD=
# Durée de conservation des positions GPS des courses terminées (jours, 0 = illimitée)
TRACK_RETENTION_DAYS=90
# Contact pour les notifications push (format mailto:)
VAPID_SUBJECT=mailto:moi@mondomaine.fr
# Serveur ntfy pour les alertes de sécurité (tu peux héberger le tien)
NTFY_SERVER=https://ntfy.sh

# Fond de carte : le plus simple est de le choisir dans l'admin (⚙️ Paramètres → Fond de carte),
# où tu peux coller ta clé MapTiler. Ces variables, si renseignées, s'imposent à l'admin :
# TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=TA_CLE
# TILE_ATTRIBUTION=&copy; MapTiler &copy; contributeurs OpenStreetMap
TILE_URL=
TILE_ATTRIBUTION=

# ---- Sauvegardes (deploy/backup.sh)
BACKUP_DIR=/var/backups/zotracker
BACKUP_KEEP_DAYS=14
# Clé publique « age » pour chiffrer les sauvegardes (fortement recommandé) :
#   age-keygen -o ~/zotracker-backup.key  (garde ce fichier HORS du serveur !)
BACKUP_AGE_RECIPIENT=
# Copie hors site (optionnelle, uniquement si chiffrée) via rclone, ex. « b2:mon-bucket/zotracker »
BACKUP_RCLONE_REMOTE=
