{
  "name": "zotracker",
  "version": "0.1.0",
  "private": true,
  "description": "Suivi GPS en direct pour courses à pied : interface admin + page publique pour les supporters",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "check": "find server public -name '*.js' -not -path '*/vendor/*' -print0 | xargs -0 -n1 node --check && eslint .",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "express": "^4.22.3",
    "leaflet": "^1.9.4",
    "qrcode-generator": "^2.0.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  }
}
